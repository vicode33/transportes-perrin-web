---
import { services } from "../data/services.js";
---

<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Encabezado -->
    <div class="mx-auto max-w-2xl text-center">

      <span class="text-sm font-semibold uppercase tracking-wider text-gray-500">
        Nuestros servicios
      </span>

      <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
        Cuidamos cada traslado
      </h2>

      <p class="mt-4 text-lg leading-8 text-gray-600">
        Ofrecemos soluciones de transporte pensadas para que tus mascotas
        viajen de manera segura, cómoda y responsable.
      </p>

    </div>

    <!-- Tarjetas -->
    <div class="mt-12 grid gap-6 md:grid-cols-3">

      {
        services.slice(0, 3).map((service) => (
          <article class="rounded-2xl border border-gray-200 p-8 transition hover:-translate-y-1 hover:shadow-lg">

            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gray-100">
              🐾
            </div>

            <h3 class="mt-6 text-xl font-semibold text-gray-900">
              {service.title}
            </h3>

            <p class="mt-3 leading-7 text-gray-600">
              {service.description}
            </p>

          </article>
        ))
      }

    </div>

    <!-- Enlace -->
    <div class="mt-10 text-center">

      <a
        href="/servicios"
        class="font-semibold text-gray-900 hover:underline"
      >
        Ver todos los servicios →
      </a>

    </div>

  </div>
</section>