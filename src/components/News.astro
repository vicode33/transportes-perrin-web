---
const news = [
  {
    title: "Próxima jornada de esterilización",
    date: "Próximamente",
    category: "Esterilización",
    description:
      "Mantente atento a nuestras próximas jornadas de esterilización para perros y gatos.",
  },
  {
    title: "Nuevo servicio de transporte",
    date: "Próximamente",
    category: "Servicios",
    description:
      "Estamos preparando nuevas opciones para facilitar el traslado seguro de tus mascotas.",
  },
  {
    title: "Actividades comunitarias",
    date: "Próximamente",
    category: "Comunidad",
    description:
      "Conoce las próximas actividades en las que estaremos participando en beneficio de las mascotas.",
  },
];
---

<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Encabezado -->
    <div class="mx-auto max-w-2xl text-center">

      <span class="text-sm font-semibold uppercase tracking-wider text-gray-500">
        Noticias
      </span>

      <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
        Entérate de nuestras novedades
      </h2>

      <p class="mt-4 text-lg leading-8 text-gray-600">
        Próximamente compartiremos información sobre nuestras actividades,
        servicios y novedades.
      </p>

    </div>

    <!-- Noticias -->
    <div class="mt-12 grid gap-6 md:grid-cols-3">

      {
        news.map((item) => (
          <article class="rounded-2xl border border-gray-200 p-6 transition hover:-translate-y-1 hover:shadow-lg">

            <div class="flex items-center justify-between">

              <span class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700">
                {item.category}
              </span>

              <span class="text-sm text-gray-500">
                {item.date}
              </span>

            </div>

            <h3 class="mt-5 text-xl font-semibold text-gray-900">
              {item.title}
            </h3>

            <p class="mt-3 leading-7 text-gray-600">
              {item.description}
            </p>

            <a
              href="#"
              class="mt-5 inline-block font-semibold text-gray-900 hover:underline"
            >
              Leer más →
            </a>

          </article>
        ))
      }

    </div>

  </div>
</section>