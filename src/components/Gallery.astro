---
const gallery = [
  {
    image:
      "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=800&q=80",
    title: "Cuidado y transporte",
  },
  {
    image:
      "https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=800&q=80",
    title: "Transporte de mascotas",
  },
  {
    image:
      "https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=800&q=80",
    title: "Bienestar animal",
  },
  {
    image:
      "https://images.unsplash.com/photo-1558788353-f76d92427f16?auto=format&fit=crop&w=800&q=80",
    title: "Viajes seguros",
  },
];
---

<section class="bg-gray-50 py-20">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Encabezado -->
    <div class="mx-auto max-w-2xl text-center">

      <span class="text-sm font-semibold uppercase tracking-wider text-gray-500">
        Galería
      </span>

      <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
        Conoce nuestro trabajo
      </h2>

      <p class="mt-4 text-lg leading-8 text-gray-600">
        Un vistazo a nuestro servicio y al compromiso que tenemos
        con cada mascota.
      </p>

    </div>

    <!-- Galería -->
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

      {
        gallery.map((item) => (
          <article class="group overflow-hidden rounded-2xl bg-white shadow-sm">

            <div class="aspect-square overflow-hidden">
              <img
                src={item.image}
                alt={item.title}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>

            <div class="p-4">
              <h3 class="font-semibold text-gray-900">
                {item.title}
              </h3>
            </div>

          </article>
        ))
      }

    </div>

  </div>
</section>