---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Nosotros | Transportes Perrin">

  <Header />

  <main>

    <!-- Presentación -->
    <section class="bg-gray-50 py-20">
      <div class="mx-auto max-w-4xl px-6 text-center">

        <span class="text-sm font-semibold uppercase tracking-wider text-gray-500">
          Nosotros
        </span>

        <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
          Transporte con compromiso y responsabilidad
        </h1>

        <p class="mt-6 text-lg leading-8 text-gray-600">
          En Transportes Perrin nos dedicamos al traslado seguro de perros
          y gatos, procurando brindar tranquilidad a sus propietarios y
          bienestar a cada mascota durante el recorrido.
        </p>

      </div>
    </section>


    <!-- Quiénes somos -->
    <section class="bg-white py-20">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 md:grid-cols-2 md:items-center">

        <div>
          <span class="text-sm font-semibold uppercase tracking-wider text-gray-500">
            Quiénes somos
          </span>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900">
            Una empresa enfocada en el bienestar animal
          </h2>

          <p class="mt-5 leading-8 text-gray-600">
            Sabemos que transportar una mascota requiere más que simplemente
            llevarla de un lugar a otro. Por eso buscamos ofrecer un servicio
            responsable, seguro y adaptado a las necesidades de cada animal.
          </p>

          <p class="mt-4 leading-8 text-gray-600">
            Nuestro objetivo es facilitar el traslado hacia clínicas
            veterinarias, jornadas de esterilización y otras actividades
            relacionadas con el cuidado de las mascotas.
          </p>
        </div>


        <div>
          <img
            src="https://images.unsplash.com/photo-1558788353-f76d92427f16?auto=format&fit=crop&w=1000&q=80"
            alt="Mascota"
            class="h-[400px] w-full rounded-2xl object-cover shadow-lg"
          />
        </div>

      </div>
    </section>


    <!-- Valores -->
    <section class="bg-gray-50 py-20">
      <div class="mx-auto max-w-7xl px-6">

        <div class="mx-auto max-w-2xl text-center">

          <span class="text-sm font-semibold uppercase tracking-wider text-gray-500">
            Nuestros valores
          </span> 

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900">
            Lo que nos identifica
          </h2>

        </div>


        <div class="mt-12 grid gap-6 md:grid-cols-3">

          <article class="rounded-2xl border border-gray-200 bg-white p-8">
            <h3 class="text-xl font-semibold text-gray-900">
              Responsabilidad
            </h3>

            <p class="mt-3 leading-7 text-gray-600">
              Cumplimos cada traslado con compromiso y atención.
            </p>
          </article>


          <article class="rounded-2xl border border-gray-200 bg-white p-8">
            <h3 class="text-xl font-semibold text-gray-900">
              Seguridad
            </h3>

            <p class="mt-3 leading-7 text-gray-600">
              Procuramos que cada mascota viaje en condiciones seguras.
            </p>
          </article>


          <article class="rounded-2xl border border-gray-200 bg-white p-8">
            <h3 class="text-xl font-semibold text-gray-900">
              Bienestar animal
            </h3>

            <p class="mt-3 leading-7 text-gray-600">
              Tratamos a cada mascota con cuidado, respeto y consideración.
            </p>
          </article>

        </div>

      </div>
    </section>

  </main>

  <Footer />

</Layout>