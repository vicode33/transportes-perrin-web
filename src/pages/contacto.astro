---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Contacto | Transportes Perrin">

  <Header />

  <main>

    <!-- Encabezado -->
    <section class="bg-gray-50 py-20">
      <div class="mx-auto max-w-4xl px-6 text-center">

        <span class="text-sm font-semibold uppercase tracking-wider text-gray-500">
          Contacto
        </span>

        <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
          Estamos para ayudarte
        </h1>

        <p class="mt-6 text-lg leading-8 text-gray-600">
          ¿Necesitas transportar a tu mascota? Comunícate con nosotros
          y coordinemos el traslado.
        </p>

      </div>
    </section>


    <!-- Contacto -->
    <section class="bg-white py-20">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 md:grid-cols-2">

        <!-- Información -->
        <div>

          <span class="text-sm font-semibold uppercase tracking-wider text-gray-500">
            Información
          </span>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900">
            Hablemos sobre el traslado de tu mascota
          </h2>

          <p class="mt-5 leading-7 text-gray-600">
            Escríbenos para consultar disponibilidad, coordinar un traslado
            o solicitar información sobre nuestros servicios.
          </p>


          <!-- WhatsApp -->
          <div class="mt-8 flex items-start gap-4">

            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gray-100">
              📱
            </div>

            <div>
              <h3 class="font-semibold text-gray-900">
                WhatsApp
              </h3>

              <a
                href="https://wa.me/50760578265"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 block text-gray-600 hover:text-gray-900"
              >
                6057-8265
              </a>
            </div>

          </div>


          <!-- Correo -->
          <div class="mt-6 flex items-start gap-4">

            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gray-100">
              ✉️
            </div>

            <div>
              <h3 class="font-semibold text-gray-900">
                Correo electrónico
              </h3>

              <a
                href="mailto:transportesperrin@gmail.com"
                class="mt-1 block text-gray-600 hover:text-gray-900"
              >
                transportesperrin@gmail.com
              </a>
            </div>

          </div>


          <!-- Ubicación -->
          <div class="mt-6 flex items-start gap-4">

            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gray-100">
              📍
            </div>

            <div>
              <h3 class="font-semibold text-gray-900">
                Cobertura
              </h3>

              <p class="mt-1 text-gray-600">
                Panamá y Panamá Oeste
              </p>
            </div>

          </div>

        </div>


        <!-- Formulario -->
        <div class="rounded-2xl border border-gray-200 p-8 shadow-sm">

          <h2 class="text-2xl font-semibold text-gray-900">
            Solicitar información
          </h2>

          <p class="mt-2 text-gray-600">
            Completa el formulario y nos pondremos en contacto contigo.
          </p>


          <form class="mt-8 space-y-6">

            <!-- Nombre -->
            <div>
              <label
                for="nombre"
                class="block text-sm font-medium text-gray-900"
              >
                Nombre
              </label>

              <input
                type="text"
                id="nombre"
                name="nombre"
                placeholder="Tu nombre"
                class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-gray-900"
              />
            </div>


            <!-- Teléfono -->
            <div>
              <label
                for="telefono"
                class="block text-sm font-medium text-gray-900"
              >
                Teléfono
              </label>

              <input
                type="tel"
                id="telefono"
                name="telefono"
                placeholder="Tu número de teléfono"
                class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-gray-900"
              />
            </div>


            <!-- Servicio -->
            <div>
              <label
                for="servicio"
                class="block text-sm font-medium text-gray-900"
              >
                Servicio
              </label>

              <select
                id="servicio"
                name="servicio"
                class="mt-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 outline-none transition focus:border-gray-900"
              >
                <option value="">Selecciona un servicio</option>
                <option value="veterinario">
                  Transporte veterinario
                </option>
                <option value="esterilizacion">
                  Transporte para esterilización
                </option>
                <option value="programado">
                  Traslado programado
                </option>
                <option value="jaulas">
                  Alquiler de jaulas y transportadoras
                </option>
              </select>
            </div>


            <!-- Mensaje -->
            <div>
              <label
                for="mensaje"
                class="block text-sm font-medium text-gray-900"
              >
                Mensaje
              </label>

              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                placeholder="Cuéntanos qué necesitas..."
                class="mt-2 w-full resize-none rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-gray-900"
              ></textarea>
            </div>


            <!-- Botón -->
            <button
              type="submit"
              class="w-full rounded-lg bg-gray-900 px-6 py-3 font-semibold text-white transition hover:bg-gray-700"
            >
              Enviar solicitud
            </button>

          </form>

        </div>

      </div>
    </section>

  </main>

  <Footer />

</Layout>